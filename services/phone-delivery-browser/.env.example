PHONE_DELIVERY_UPSTREAM_SECRET=replace-with-at-least-32-random-characters
PHONE_DELIVERY_BROWSER_HOST=127.0.0.1
PHONE_DELIVERY_BROWSER_PORT=8787
PHONE_DELIVERY_PROFILE=/data/profile
PHONE_DELIVERY_HEADLESS=false
