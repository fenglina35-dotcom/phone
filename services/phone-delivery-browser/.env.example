PHONE_DELIVERY_UPSTREAM_SECRET=replace-with-at-least-32-random-characters
PHONE_DELIVERY_BROWSER_HOST=127.0.0.1
PHONE_DELIVERY_BROWSER_PORT=8787
PHONE_DELIVERY_PROFILE=/data/profile
PHONE_DELIVERY_HEADLESS=false
# 推荐：连接到本人手动启动、可见且保持登录的 Chrome/Edge。留空时由服务启动独立浏览器。
PHONE_DELIVERY_CDP_URL=http://127.0.0.1:9222
# 可选：复用主机已安装的 Chrome／Edge，留空则使用 Playwright Chromium
PHONE_DELIVERY_CHROME_PATH=
PHONE_DELIVERY_MAX_ORDER_AMOUNT=100
PHONE_DELIVERY_MAX_OFFERS=4
PHONE_DELIVERY_VNC_PASSWORD=replace-with-a-strong-password
